# Intelligence mode: 'local' (Claude Code CLI), 'cloud' (API key), 'auto' (try local first)
# Local mode uses your Claude subscription via the `claude` CLI — no API costs.
# Cloud mode uses the Anthropic API — requires ANTHROPIC_API_KEY below.
INTELLIGENCE_MODE=auto

# Only needed for cloud mode. Get your key from platform.claude.com
ANTHROPIC_API_KEY=

# Optional: For premium cloud voice (gpt-4o-mini-tts). Not needed if using Kokoro.
OPENAI_API_KEY=

# Optional: Server port (default: 3847)
# PORT=3847
